# ======================================================
# TakeoutSystem 测试框架环境配置示例
# 复制为 .env 文件并修改
# ======================================================

# 运行环境（dev / test / staging / prod）
ENV=test

# 后端 API 地址
TAKEOUT_API_URL=http://localhost:8080

# 请求行为
API_TIMEOUT=30
API_VERIFY_SSL=false

# 功能开关
ENABLE_PLUGINS=true
USE_MOCK=true

# 前端 UI 地址（Selenium）
H5_BASE_URL=http://localhost:3001
MERCHANT_BASE_URL=http://localhost:3002
ADMIN_BASE_URL=http://localhost:3003

# 浏览器配置
BROWSER=chrome
HEADLESS=false
WAIT_TIMEOUT=10

# 日志
LOG_LEVEL=INFO

# 测试账号
TEST_SMS_CODE=123456
TEST_CUSTOMER_PHONE=13800000003
TEST_MERCHANT1_PHONE=13800000002
TEST_MERCHANT2_PHONE=13800000004
TEST_ADMIN_PHONE=13800000001
